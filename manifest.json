{
  "manifest_version": 3,
  "name": "Keeping Keyboard Shortcuts",
  "version": "1.3.2",
  "description": "Keyboard shortcuts for Keeping.com helpdesk app",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://app.keeping.com/*"],
      "css": ["styles.css"],
      "js": ["shortcuts.js", "hints.js", "modal.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "keeping-shortcuts@munksapp.com",
      "strict_min_version": "109.0"
    }
  }
}
