{
  "manifest_version": 3,
  "name": "Keeping Keyboard Shortcuts",
  "version": "1.0",
  "description": "Keyboard shortcuts for Keeping.com helpdesk app",
  "content_scripts": [
    {
      "matches": ["https://app.keeping.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
